# Dipendenze e build: reinstallate/ricostruite dentro l'immagine
node_modules
**/node_modules
packages/web/dist
**/dist

# Dati personali e media: arrivano da volumi montati, mai dentro l'immagine.
# M97 — la libreria è /library nel container e thumbnails/avatars stanno in
# cima; le impostazioni dell'applicazione arrivano da /config.
/data
/videos
/thumbnails
/avatars
/config

# Binari: l'immagine se li scarica da sé in build (stage "tools" di
# Dockerfile.web, in /opt/ondo/bin). Quelli locali sono per il sistema dello
# sviluppatore — su Windows sarebbero .exe: mai dentro l'immagine.
/tools

# Cookie YouTube (personali, mai nell'immagine)
core/cookies.txt

# Git, ambiente, editor
.git
.gitignore
.dockerignore
.env
.env.local
.env.*.local
.claude

# Non necessari a runtime nell'immagine web
.github
docs/
scripts/
README.md

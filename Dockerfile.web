# syntax=docker/dockerfile:1

# Immagine Docker della sola parte web: API (packages/server, usa @catalog/core)
# + Web GUI compilata (packages/web) in un unico container/porta. Non include
# la CLI (packages/ondo-cli) — quella si distribuisce a parte
# come .tgz nella release (vedi .github/workflows/release-ondo-cli.yml).
#
# Base Debian/glibc (non Alpine/musl): il binario ufficiale yt-dlp_linux è un
# eseguibile PyInstaller costruito su glibc, non gira su Alpine.
#
# M94 — yt-dlp, ffmpeg e ffprobe stanno DENTRO l'immagine, in /opt/ondo/bin (che
# è nel PATH). Prima yt-dlp non c'era e andava messo a mano in un volume montato
# su /app/tools: il primo avvio era rotto per costruzione, e senza CLI né
# package.json nell'immagine non c'era nemmeno un comando per rimediare.
# Scavalcarli resta possibile e ha ancora la precedenza (vedi config.js:
# tools/ → PATH): dal M98.1 la cartella dei binari segue quella della
# configurazione, quindi basta mettere il file in /config/tools — volume già
# montato, nessun mount aggiuntivo. Aggiornare yt-dlp senza rebuild continua a
# funzionare, solo che ora è un'opzione e non un prerequisito.

# ── Stage 1: binari esterni (yt-dlp, ffmpeg, ffprobe) ────────────────────────
# Gira sulla piattaforma di BUILD (non emulata) e sceglie i binari in base a
# TARGETARCH: scaricare non richiede di eseguire ciò che si scarica, quindi
# QEMU qui sarebbe solo lentezza. Per lo stesso motivo non si verificano con
# `--version`: un binario arm64 non è eseguibile su un runner amd64.
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS tools
ARG TARGETARCH

# xz-utils NON è nell'immagine node:22-bookworm-slim e nemmeno qui: GNU tar
# delega la decompressione .xz al binario `xz`, e le build di ffmpeg sono
# .tar.xz — senza, l'estrazione fallisce con un errore che sembra un problema
# di tar.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
  && rm -rf /var/lib/apt/lists/*

# yt-dlp: release ufficiali. Su ARM l'asset si chiama yt-dlp_linux_aarch64 ma va
# SALVATO come yt-dlp_linux, che è il nome cercato a runtime a prescindere
# dall'architettura (expectedToolNames in core/src/config.js).
# ffmpeg: build STATICHE di BtbN (non si portano dietro DLL/librerie sparse).
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) ytdlp_asset='yt-dlp_linux';         ffmpeg_asset='ffmpeg-master-latest-linux64-gpl.tar.xz' ;; \
      arm64) ytdlp_asset='yt-dlp_linux_aarch64'; ffmpeg_asset='ffmpeg-master-latest-linuxarm64-gpl.tar.xz' ;; \
      *) echo "TARGETARCH non supportata: '$TARGETARCH'" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out /tmp/ff; \
    curl -fsSL -o /out/yt-dlp_linux \
      "https://github.com/yt-dlp/yt-dlp/releases/latest/download/${ytdlp_asset}"; \
    curl -fsSL -o /tmp/ffmpeg.tar.xz \
      "https://github.com/BtbN/FFmpeg-Builds/releases/latest/download/${ffmpeg_asset}"; \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp/ff; \
    find /tmp/ff -type f -name ffmpeg  -exec install -m 0755 {} /out/ffmpeg  \; ; \
    find /tmp/ff -type f -name ffprobe -exec install -m 0755 {} /out/ffprobe \; ; \
    chmod 0755 /out/yt-dlp_linux; \
    ln -s yt-dlp_linux /out/yt-dlp; \
    for f in yt-dlp_linux ffmpeg ffprobe; do test -s "/out/$f" || { echo "manca /out/$f" >&2; exit 1; }; done; \
    rm -rf /tmp/ff /tmp/ffmpeg.tar.xz; \
    ls -l /out

# ── Stage 2: build della web ─────────────────────────────────────────────────
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# Solo i manifest per primi, per la cache dei layer. npm ci ha bisogno di
# TUTTI i workspace del monorepo per essere coerente con package-lock.json,
# anche se nell'immagine finale (stage 2) entrano solo core, packages/server
# e la build statica di packages/web.
COPY package.json package-lock.json ./
COPY core/package.json ./core/
COPY packages/ondo-cli/package.json ./packages/ondo-cli/
COPY packages/server/package.json ./packages/server/
COPY packages/web/package.json ./packages/web/
RUN npm ci

# Sorgenti e build della sola web (produce packages/web/dist).
COPY core ./core
COPY packages ./packages
RUN npm run web:build

# Elimina i devDependencies (vite, plugin di build): non servono a runtime,
# la web è ormai statica in packages/web/dist.
RUN npm prune --omit=dev

# ── Stage 3: runtime — solo core + server + web/dist, niente CLI ───────────
FROM node:22-bookworm-slim
ENV NODE_ENV=production

# M97 — le due cartelle che il container si aspetta montate:
#
#   /library  la libreria (data/, videos/, thumbnails/, avatars/)
#   /config   le impostazioni dell'applicazione (web.json)
#
# Sono separate perché sono due cose diverse: l'archivio, che è tuo e vive dove
# vuoi, e la configurazione del programma, che accompagna l'installazione — qui
# il "docker-compose.yml" sull'host. Nell'immagine il codice sta in /app e non è
# scrivibile, quindi il file DEVE arrivare da un volume: senza, si perderebbe a
# ogni `docker compose pull`.
ENV ONDO_CONFIG_DIR=/config
# M98 — ONDO_LIBRARY è OBBLIGATORIA, non una comodità: da M98 la libreria è «la
# cartella in cui ti trovi», e la cartella di lavoro del container è /app, che
# non è una libreria. Senza questa variabile il server si fermerebbe all'avvio.
ENV ONDO_LIBRARY=/library

# ca-certificates per le connessioni TLS (miniature, avatar, API di YouTube via
# yt-dlp). ffmpeg NON arriva più da apt: quello di Debian 12 è la 5.1.x, mentre
# la build statica copiata sotto è aggiornata e identica su amd64 e arm64.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# I tre binari esterni, nel PATH. In /opt/ondo/bin e non in una cartella che
# l'utente potrebbe montare: un volume sopra di essa nasconderebbe il contenuto
# dell'immagine, e ci troveremmo di nuovo senza yt-dlp.
COPY --from=tools /out/ /opt/ondo/bin/
ENV PATH="/opt/ondo/bin:${PATH}"

WORKDIR /app

# node_modules pruned dal builder: resta un symlink orfano di
# @catalog/ondo-cli (i suoi sorgenti non sono copiati qui sotto) più i
# pacchetti npm usati solo da lui (commander, @inquirer/prompts) —
# inutilizzati ma innocui, qualche centinaio di KB.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/core ./core
COPY --from=builder /app/packages/server ./packages/server
COPY --from=builder /app/packages/web/dist ./packages/web/dist

# L'API ascolta sulla porta di config/web.json (default 3001).
EXPOSE 3001

# Verifica che il server risponda (root → index.html, la web è servita da qui).
# Porta 3001 = default di config/web.json; se la cambi lì, aggiorna anche qui.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "packages/server/src/index.js"]

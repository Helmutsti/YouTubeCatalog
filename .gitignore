# Binari esterni: pesano ~300MB, non si versionano mai.
/tools/

# Artefatti di compilazione (centinaia di MB). Cargo.lock invece è versionato:
# il workspace produce dei binari, quindi la build deve essere riproducibile.
/target/

# La libreria dell'utente: catalogo, video, copertine, metadati, staging.
# Il nome è il default; con ONDO_ROOT può stare in qualunque altra cartella.
/ondo-data/

# Cookie della sessione YouTube: dati personali.
cookies.txt

.claude/
.env
.env.local
.env.*.local

# Dipendenze e build del frontend.
/ondo-web/fe/node_modules/
/ondo-web/fe/dist/

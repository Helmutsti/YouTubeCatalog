# Binari esterni: procurati da `npm run setup`, mai versionati (peserebbero
# ~100-190MB per aggiornamento nella history). Si ignora l'intera cartella
# invece dei singoli nomi, così coprono anche i .tmp della scrittura atomica
# e i nomi di nuove piattaforme senza dover aggiornare questo file.
/tools/
core/cookies.txt

# Artefatti di compilazione Rust (rust/target arriva a centinaia di MB).
# Cargo.lock INVECE è versionato: è un workspace con dei binari, quindi la
# build deve essere riproducibile.
/rust/target/

.env
.env.local
.env.*.local

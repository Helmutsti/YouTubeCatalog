{
  "name": "youtube-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "npm run build --workspace=@catalog/web",
    "start": "node packages/server/src/index.js",
    "serve": "npm run build && npm start",
    "cli": "node packages/cli/cli.js",
    "cli:rust": "cargo run --release --manifest-path rust/Cargo.toml -p ondo-cli",
    "rust:build": "cargo build --release --manifest-path rust/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:difftest": "node rust/difftest.mjs --fixture",
    "server": "node packages/server/src/index.js",
    "server:local": "node packages/server/src/index.js --local",
    "web": "npm run dev --workspace=packages/web",
    "web:lan": "npm run dev:lan --workspace=packages/web"
  },
  "workspaces": [
    "core",
    "packages/*"
  ]
}
